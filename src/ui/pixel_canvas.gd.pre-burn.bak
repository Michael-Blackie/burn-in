extends TextureRect

@export var col_1 : Color
@export var col_2 : Color

var grid_size : int

var alive : PackedInt32Array
var slot : PackedInt32Array
var is_ink: PackedByteArray

var total_paper : int = 0
var dirty : bool = false
var _cleared : bool = false
var _acc : float = 0.0

var image : Image

const BURN_TIME := 0.3
var burning: PackedInt32Array
var burn_t: PackedFloat32Array

signal canvas_cleared
signal pixel_erased(remaining : int, total : int)


func _ready() -> void:
	canvas_cleared.connect(GameManager.new_grid)

	reset(GameManager.grid_size)
	GameManager.grid_changed.connect(func(size, _n): reset(size))
	reset(GameManager.grid_size)
	
	
func _process(delta: float) -> void:
	# Handle auto clickers
	_acc += GameManager.auto_rate * delta
	var n := int(_acc)
	if n > 0 and not _cleared:
		var erased := erase_random(n)
		_acc -= erased                     # what wasn't used carries over to the next grid
		if erased > 0:
			GameManager.add_ash(erased)
			pixel_erased.emit(alive.size(), total_paper)
		check_cleared()
		
	_update_burning(delta)
	# Handle grid updates
	if dirty:
		texture.update(image)
		dirty = false

func update_image(x: int, y: int):
	var erased = erase_index(y * grid_size + x)

	if not erased or _cleared:   # already erased
		return

	image.set_pixel(x, y, col_2)
	dirty = true
	GameManager.add_ash(1)
	pixel_erased.emit(alive.size(), total_paper)
	check_cleared()

func reset(new_size: int) -> void:
	var tex := GameManager.current_page()
	if tex:
		image = tex.get_image()                      # gives you a copy, safe to edit
		image.convert(Image.FORMAT_RGBA8)            # imported images may not be RGBA8
	else:
		image = Image.create(new_size, new_size, false, Image.FORMAT_RGBA8)
		image.fill(col_1)
	grid_size = image.get_width()
	var total := grid_size * grid_size
	alive.clear(); slot.resize(total); is_ink.resize(total)

	for i in total:
		var paper := image.get_pixel(i % grid_size, i / grid_size).r > 0.5
		is_ink[i] = 0 if paper else 1
		if paper:
			slot[i] = alive.size(); alive.append(i)
		else:
			slot[i] = -1                             # ink can never be erased

	total_paper = alive.size()
	texture = ImageTexture.create_from_image(image)  # new size means a new texture
	_cleared = false
	pixel_erased.emit(alive.size(), total_paper)


func _gui_input(event: InputEvent) -> void:
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and event.pressed:
		var cell = find_pos_in_grid(event.position)
		update_image(cell.x, cell.y)
			

func find_pos_in_grid(pos: Vector2):
	var cell_size := size / grid_size   # separate x/y in case it's not square
	var coords := Vector2i((pos / cell_size).floor())
	return coords.clamp(Vector2i.ZERO, Vector2i(grid_size - 1, grid_size - 1))

func erase_index(i: int) -> bool:
	var s := slot[i]
	if s == -1:
		return false                  # already erased; this replaces your get_pixel check

	var last := alive[alive.size() - 1]
	alive[s] = last                   # move the last entry into the gap
	slot[last] = s                    # tell it where it lives now
	alive.resize(alive.size() - 1)    # drop the old last entry
	slot[i] = -1

	burning.append(i); burn_t.append(0.0)
	dirty = true
	return true

func erase_random(n: int) -> int:
	var erased := 0
	while erased < n and alive.size() > 0:
		erase_index(alive[randi() % alive.size()])
		erased += 1
	return erased
	
func check_cleared():
	if alive.is_empty() and not _cleared:
		_cleared = true
		while burning.size() > 0: await get_tree().process_frame
		await get_tree().create_timer(1).timeout
		canvas_cleared.emit()

func _update_burning(delta: float) -> void:
	var k := burning.size() - 1
	while k >= 0:                                   # go backwards so swap-remove is safe
		burn_t[k] += delta
		var i := burning[k]
		var x := i % grid_size; var y := i / grid_size
		if burn_t[k] >= BURN_TIME:
			image.set_pixel(x, y, col_2)            # finished: ash
			_scorch_neighbours(x, y)
			burning[k] = burning[-1]; burn_t[k] = burn_t[-1]
			burning.resize(burning.size() - 1); burn_t.resize(burn_t.size() - 1)
		else:
			var frame := int(burn_t[k] / 0.05)      # flickers every 0.05s
			image.set_pixel(x, y, col_2 if (frame + x + y) % 2 == 0 else col_1)
		k -= 1
	if burning.size() > 0: dirty = true

func _scorch_neighbours(x: int, y: int) -> void:
	for o in [Vector2i(1,0), Vector2i(-1,0), Vector2i(0,1), Vector2i(0,-1)]:
		var nx = x + o.x; var ny = y + o.y
		if nx < 0 or ny < 0 or nx >= grid_size or ny >= grid_size: continue
		if is_ink[ny * grid_size + nx] == 1:
			image.set_pixel(nx, ny, col_1)